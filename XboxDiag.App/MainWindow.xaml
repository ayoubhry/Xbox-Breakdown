<Window x:Class="XboxDiag.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:XboxDiag.App.ViewModels"
        mc:Ignorable="d"
        Title="Xbox Breakdown — Système de Diagnostic Expert Xbox One"
        Icon="Resources/app.ico"
        Height="880" Width="1380"
        MinHeight="680" MinWidth="1000"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Background>
        <!-- Fond spatial immersif Xbox Dashboard (Dégradé nébuleuse sombre + vert Xbox) -->
        <RadialGradientBrush Center="0.5,0.0" RadiusX="1.1" RadiusY="0.9" GradientOrigin="0.5,0.0">
            <GradientStop Color="#142C1D" Offset="0.0" />
            <GradientStop Color="#111B24" Offset="0.32" />
            <GradientStop Color="#0D1217" Offset="0.65" />
            <GradientStop Color="#07090C" Offset="1.0" />
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- Style des Boutons Pilules de Navigation Globale (Inspiré Dashboard Xbox) -->
        <Style x:Key="GlobalTopNavButton" TargetType="Button">
            <Setter Property="Background" Value="#1C232B" />
            <Setter Property="BorderBrush" Value="#2D3748" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource XboxGreenBrush}" />
                                <Setter TargetName="border" Property="Background" Value="#27323F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#107C10" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Pilule Actif Accueil -->
        <Style x:Key="BtnNavAccueilPill" TargetType="Button" BasedOn="{StaticResource GlobalTopNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAccueilActive}" Value="True">
                    <Setter Property="Background" Value="#107C10" />
                    <Setter Property="BorderBrush" Value="#1BE31B" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style Pilule Actif Nouveau Diagnostic -->
        <Style x:Key="BtnNavNouveauPill" TargetType="Button" BasedOn="{StaticResource GlobalTopNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNouveauDiagnosticActive}" Value="True">
                    <Setter Property="Background" Value="#107C10" />
                    <Setter Property="BorderBrush" Value="#1BE31B" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style Pilule Actif Historique -->
        <Style x:Key="BtnNavHistoriquePill" TargetType="Button" BasedOn="{StaticResource GlobalTopNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHistoriqueActive}" Value="True">
                    <Setter Property="Background" Value="#107C10" />
                    <Setter Property="BorderBrush" Value="#1BE31B" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style Pilule Actif Base de Connaissances -->
        <Style x:Key="BtnNavBasePill" TargetType="Button" BasedOn="{StaticResource GlobalTopNavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBaseConnaissancesActive}" Value="True">
                    <Setter Property="Background" Value="#107C10" />
                    <Setter Property="BorderBrush" Value="#1BE31B" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. BARRE SUPÉRIEURE XBOX GLOBALE (Présente sur tous les écrans) -->
            <RowDefinition Height="Auto" />
            <!-- 2. CONTENU DE L'ÉCRAN ACTIF -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 1. BARRE SUPÉRIEURE XBOX DASHBOARD (PERMANENTE & RÉACTIVE)-->
        <!-- ========================================================= -->
        <Border Grid.Row="0"
                Background="#0D1217"
                BorderBrush="#232C36"
                BorderThickness="0,0,0,1"
                Padding="28,14,28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Identité et Statut Atelier à gauche -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Raccourcis de navigation au centre -->
                    <ColumnDefinition Width="*" />
                    <!-- Horloge et badges système à droite -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- GAUCHE : IDENTITÉ XBOXDIAG & SPHERES XBOX -->
                <Button Grid.Column="0"
                        Command="{Binding NaviguerAccueilCommand}"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Logo Officiel Xbox Breakdown -->
                                <Image Source="Resources/app.png"
                                       Width="38" Height="38"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Margin="0,0,12,0" />

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Xbox Breakdown"
                                                   FontSize="16.5"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                        <!-- Badge ULTIMATE EXPERT -->
                                        <Border Background="#202A35"
                                                BorderBrush="#107C10"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="EXPERT PRO"
                                                       FontSize="10"
                                                       FontWeight="ExtraBold"
                                                       Foreground="{StaticResource XboxGreenBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Statut du moteur -->
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                                        <Border Width="7" Height="7" CornerRadius="3.5" Background="#1BE31B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Moteur d'inférence déterministe actif"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#94A3B8" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- CENTRE : PILULES DE NAVIGATION RAPIDE (Style Xbox Dashboard) -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                    <!-- Accueil -->
                    <Button Style="{StaticResource BtnNavAccueilPill}"
                            Command="{Binding NaviguerAccueilCommand}"
                            ToolTip="Retour au tableau de bord principal">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏠" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Accueil" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Nouveau diagnostic -->
                    <Button Style="{StaticResource BtnNavNouveauPill}"
                            Command="{Binding NaviguerNouveauDiagnosticCommand}"
                            ToolTip="Démarrer une nouvelle analyse guidée de console">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Nouveau diagnostic" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Reprendre diagnostic -->
                    <Button Style="{StaticResource GlobalTopNavButton}"
                            Command="{Binding NaviguerReprendreCommand}"
                            ToolTip="Reprendre une session existante ou inspecter les dossiers">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Reprendre" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Historique -->
                    <Button Style="{StaticResource BtnNavHistoriquePill}"
                            Command="{Binding NaviguerHistoriqueCommand}"
                            ToolTip="Consulter l'historique complet des interventions et dossiers">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📜" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Historique" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Base de connaissances -->
                    <Button Style="{StaticResource BtnNavBasePill}"
                            Command="{Binding NaviguerBaseConnaissancesCommand}"
                            ToolTip="Consulter l'arbre des 8 pannes, 16 fiches tests et 37 symptômes">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📚" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Base de connaissances" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- DROITE : HORLOGE & DATE EN DIRECT FAÇON XBOX -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#161E26" CornerRadius="8" Padding="12,6" BorderThickness="1" BorderBrush="#2A3746">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🕒" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeureActuelle}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="White" />
                                <TextBlock Text="{Binding DateActuelle}"
                                           FontSize="10"
                                           Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. CONTENU PLEIN ÉCRAN DE L'APPLICATION                    -->
        <!-- ========================================================= -->
        <Border Grid.Row="1" Background="Transparent">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>
    </Grid>
</Window>
