<UserControl x:Class="XboxDiag.App.Views.AccueilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="950" d:DesignWidth="1380">

    <UserControl.Resources>
        <!-- Style des Boutons Icônes du Top Bar (Inspiré Dashboard Xbox) -->
        <Style x:Key="TopNavIconButton" TargetType="Button">
            <Setter Property="Background" Value="#22272E" />
            <Setter Property="BorderBrush" Value="#38424D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#107C10" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#169C16" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0E5A0E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style de la Grande Tuile Hero (Starfield style avec cadre vert vif Xbox) -->
        <Style x:Key="HeroTileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="outerBorder"
                                CornerRadius="14"
                                Background="#0D1612"
                                BorderBrush="#107C10"
                                BorderThickness="3.5"
                                Padding="0">
                            <!-- Effet de halo au survol -->
                            <Grid x:Name="heroContent">
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerBorder" Property="BorderBrush" Value="#1BE31B" />
                                <Setter TargetName="outerBorder" Property="Background" Value="#102018" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="outerBorder" Property="BorderBrush" Value="#0E5A0E" />
                                <Setter TargetName="outerBorder" Property="Background" Value="#0A160F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style des Tuiles Secondaires Carrées / Verticales (Inspiré rangée jeux Xbox) -->
        <Style x:Key="SquareTileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tileBorder"
                                CornerRadius="12"
                                Background="#191F26"
                                BorderBrush="#2C3540"
                                BorderThickness="1.5"
                                Padding="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tileBorder" Property="BorderBrush" Value="#107C10" />
                                <Setter TargetName="tileBorder" Property="BorderThickness" Value="2.5" />
                                <Setter TargetName="tileBorder" Property="Background" Value="#222B36" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="tileBorder" Property="BorderBrush" Value="#0E5A0E" />
                                <Setter TargetName="tileBorder" Property="Background" Value="#161B22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style des Tuiles Larges Inférieures (Inspiré bas dashboard Xbox) -->
        <Style x:Key="WideTileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cardBorder"
                                CornerRadius="12"
                                Background="#151A21"
                                BorderBrush="#2A333E"
                                BorderThickness="1.5"
                                Padding="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#107C10" />
                                <Setter TargetName="cardBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="cardBorder" Property="Background" Value="#1C232D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#0E5A0E" />
                                <Setter TargetName="cardBorder" Property="Background" Value="#13171E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- DASHBOARD XBOX CONTENU PRINCIPAL -->
    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24,32,32">

                <!-- ========================================================= -->
                <!-- 2. SECTION CENTRALE : RANGÉE DES TUILES DASHBOARD XBOX     -->
                <!-- ========================================================= -->
                <TextBlock Text="ACTIONS &amp; MODULES DU SYSTÈME EXPERT"
                           FontSize="12"
                           FontWeight="ExtraBold"
                           Foreground="{StaticResource XboxGreenBrush}"
                           Margin="0,0,0,12" />

                <!-- Grille principale : Tuile Hero à gauche + Rangée horizontale de tuiles secondaires -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <!-- Grande Tuile Hero (Nouveau Diagnostic) -->
                        <ColumnDefinition Width="340" />
                        <!-- Rangée défilante des Tuiles Secondaires -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- A. GRANDE TUILE PRINCIPALE : NOUVEAU DIAGNOSTIC (Cadre Starfield Focus) -->
                    <Button Grid.Column="0"
                            Style="{StaticResource HeroTileButton}"
                            Command="{Binding NouveauDiagnosticCommand}"
                            Height="230"
                            Margin="0,0,16,0">
                        <Grid>
                            <!-- Fond visuel avec dégradé vert émeraude / high-tech -->
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10361A" Offset="0.0" />
                                    <GradientStop Color="#0B1C12" Offset="0.5" />
                                    <GradientStop Color="#07130C" Offset="1.0" />
                                </LinearGradientBrush>
                            </Grid.Background>

                            <!-- Motifs géométriques vectoriels (Circuits électroniques / Silhouette Xbox) -->
                            <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="140" Height="140" Opacity="0.18">
                                <Path Data="M 10,20 L 70,20 L 100,50 L 130,50 M 30,60 L 80,60 L 110,90 L 140,90 M 50,10 L 50,80 L 80,110"
                                      Stroke="#107C10" StrokeThickness="2.5" />
                                <Ellipse Canvas.Left="125" Canvas.Top="45" Width="10" Height="10" Fill="#107C10" />
                                <Ellipse Canvas.Left="135" Canvas.Top="85" Width="10" Height="10" Fill="#107C10" />
                            </Canvas>

                            <!-- Contenu de la tuile Hero -->
                            <Grid Margin="20,18,20,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- En-tête : Badge et Icône Éclair -->
                                <DockPanel Grid.Row="0">
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#107C10" HorizontalAlignment="Left">
                                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border HorizontalAlignment="Right" Background="#16A34A" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="PRINCIPAL" FontSize="10" FontWeight="ExtraBold" Foreground="White" />
                                    </Border>
                                </DockPanel>

                                <!-- Titre & Description technique -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,10">
                                    <TextBlock Text="Nouveau diagnostic"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="Identifiez l'origine d'une panne matérielle ou logicielle et obtenez des recommandations de réparation précises."
                                               FontSize="12.5"
                                               Foreground="#D1D5DB"
                                               TextWrapping="Wrap"
                                               LineHeight="17" />
                                </StackPanel>

                                <!-- Footer : Bouton interactif façon Xbox -->
                                <Border Grid.Row="2"
                                        Background="#107C10"
                                        CornerRadius="8"
                                        Padding="14,9">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="Lancer le diagnostic" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Text="➔" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Button>

                    <!-- B. TUILES SECONDAIRES ALIGNÉES (Style Galerie de Cartes Xbox) -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">

                            <!-- TUILE 1 : REPRENDRE UN DIAGNOSTIC -->
                            <Button Style="{StaticResource SquareTileButton}"
                                    Command="{Binding ReprendreDiagnosticCommand}"
                                    Width="180" Height="230"
                                    Margin="0,0,14,0">
                                <Grid Margin="16,16,16,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Tag & Icône -->
                                    <Border Grid.Row="0" Width="40" Height="40" CornerRadius="10" Background="#232C37" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="🔄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="Reprendre"
                                               FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="SESSION ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource XboxGreenBrush}" Margin="0,0,0,3" />
                                        <TextBlock Text="{Binding DerniereSessionModele}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DerniereSessionTexte}" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Border Grid.Row="3" Background="#232D38" CornerRadius="6" Padding="8,6">
                                        <TextBlock Text="Continuer ➔" FontSize="11" FontWeight="Bold" Foreground="{StaticResource XboxGreenBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- TUILE 2 : HISTORIQUE DES RÉPARATIONS -->
                            <Button Style="{StaticResource SquareTileButton}"
                                    Command="{Binding VoirHistoriqueCommand}"
                                    Width="180" Height="230"
                                    Margin="0,0,14,0">
                                <Grid Margin="16,16,16,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Width="40" Height="40" CornerRadius="10" Background="#232C37" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="📜" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="Historique"
                                               FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="DOSSIERS ATELIER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource XboxGreenBrush}" Margin="0,0,0,3" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TotalSessions}" FontSize="20" FontWeight="ExtraBold" Foreground="White" />
                                            <TextBlock Text=" sessions" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                                        </StackPanel>
                                        <TextBlock Text="Recherche S/N, export CSV et sauvegardes." FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Border Grid.Row="3" Background="#232D38" CornerRadius="6" Padding="8,6">
                                        <TextBlock Text="Consulter ➔" FontSize="11" FontWeight="Bold" Foreground="{StaticResource XboxGreenBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- TUILE 3 : BASE DE CONNAISSANCES -->
                            <Button Style="{StaticResource SquareTileButton}"
                                    Command="{Binding VoirBaseConnaissancesCommand}"
                                    Width="180" Height="230"
                                    Margin="0,0,14,0">
                                <Grid Margin="16,16,16,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Width="40" Height="40" CornerRadius="10" Background="#232C37" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="📚" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="Base Experte"
                                               FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="RÈGLES D'EXPERTISE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource XboxGreenBrush}" Margin="0,0,0,3" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding NombrePannes}" FontSize="20" FontWeight="ExtraBold" Foreground="White" />
                                            <TextBlock Text=" pannes majeures" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                                        </StackPanel>
                                        <TextBlock Text="Arbres de déductions logiques et pondérations." FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Border Grid.Row="3" Background="#232D38" CornerRadius="6" Padding="8,6">
                                        <TextBlock Text="Explorer ➔" FontSize="11" FontWeight="Bold" Foreground="{StaticResource XboxGreenBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- TUILE 4 : FICHES DE TESTS TECHNIQUES -->
                            <Button Style="{StaticResource SquareTileButton}"
                                    Command="{Binding VoirTestsCommand}"
                                    Width="180" Height="230"
                                    Margin="0,0,14,0">
                                <Grid Margin="16,16,16,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Width="40" Height="40" CornerRadius="10" Background="#232C37" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="🧪" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="16 Fiches Tests"
                                               FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="PROTOCOLES GUIDÉS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource XboxGreenBrush}" Margin="0,0,0,3" />
                                        <TextBlock Text="Multimètre, boot 480p, bypass, oscillo..." FontSize="11" Foreground="#D1D5DB" TextWrapping="Wrap" />
                                        <TextBlock Text="Consignes de sécurité et matériel requis." FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Border Grid.Row="3" Background="#232D38" CornerRadius="6" Padding="8,6">
                                        <TextBlock Text="Voir tests ➔" FontSize="11" FontWeight="Bold" Foreground="{StaticResource XboxGreenBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- TUILE 5 : CATALOGUE DES 37 SYMPTÔMES -->
                            <Button Style="{StaticResource SquareTileButton}"
                                    Command="{Binding VoirSymptomesCommand}"
                                    Width="180" Height="230"
                                    Margin="0,0,0,0">
                                <Grid Margin="16,16,16,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Width="40" Height="40" CornerRadius="10" Background="#232C37" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="37 Symptômes"
                                               FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="CATALOGUE COMPLET" FontSize="10" FontWeight="Bold" Foreground="{StaticResource XboxGreenBrush}" Margin="0,0,0,3" />
                                        <TextBlock Text="Classés par catégorie :" FontSize="11" Foreground="#D1D5DB" />
                                        <TextBlock Text="Alimentation, HDMI, optique, stockage, thermique." FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Border Grid.Row="3" Background="#232D38" CornerRadius="6" Padding="8,6">
                                        <TextBlock Text="Catalogue ➔" FontSize="11" FontWeight="Bold" Foreground="{StaticResource XboxGreenBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ========================================================= -->
                <!-- 3. SECTION INFÉRIEURE : LES 4 GRANDES CARTES VUE D'ENSEMBLE-->
                <!-- ========================================================= -->
                <TextBlock Text="VUE D'ENSEMBLE, STATISTIQUES &amp; BONNES PRATIQUES D'ATELIER"
                           FontSize="12"
                           FontWeight="ExtraBold"
                           Foreground="{StaticResource XboxGreenBrush}"
                           Margin="0,8,0,12" />

                <!-- Grille des 4 Cartes Larges (Inspiré bas de page Xbox Dashboard) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CARTE 1 : DERNIÈRE INTERVENTION & SESSION -->
                    <Button Grid.Column="0"
                            Style="{StaticResource WideTileButton}"
                            Command="{Binding ReprendreDerniereSessionCommand}"
                            Height="190"
                            Margin="0,0,12,0">
                        <Grid Margin="18,16,18,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <Border Background="#107C10" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="ACTIVITÉ RÉCENTE" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock Text="🎮" FontSize="16" HorizontalAlignment="Right" />
                            </DockPanel>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding DerniereSessionModele}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,10,0,4"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="{Binding DerniereSessionTexte}"
                                           FontSize="12"
                                           Foreground="#9CA3AF"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DerniereSessionStatut, StringFormat='Statut : {0}'}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource XboxGreenBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Row="3"
                                       Text="Reprendre cette session ➔"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource XboxGreenBrush}" />
                        </Grid>
                    </Button>

                    <!-- CARTE 2 : STATISTIQUES & PERFORMANCE ATELIER -->
                    <Button Grid.Column="1"
                            Style="{StaticResource WideTileButton}"
                            Command="{Binding VoirHistoriqueCommand}"
                            Height="190"
                            Margin="0,0,12,0">
                        <Grid Margin="18,16,18,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="STATISTIQUES ATELIER" FontSize="9.5" FontWeight="Bold" Foreground="#60A5FA" />
                                </Border>
                                <TextBlock Text="📊" FontSize="16" HorizontalAlignment="Right" />
                            </DockPanel>

                            <TextBlock Grid.Row="1"
                                       Text="Bilan des réparations"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,10,0,6" />

                            <StackPanel Grid.Row="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="• Diagnostics : " FontSize="11.5" Foreground="#9CA3AF" />
                                    <TextBlock Text="{Binding TotalSessions}" FontSize="12" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="• Dossiers clôturés : " FontSize="11.5" Foreground="#9CA3AF" />
                                    <TextBlock Text="{Binding TotalReparationsCloturees}" FontSize="12" FontWeight="Bold" Foreground="#107C10" />
                                </StackPanel>
                                <TextBlock Text="{Binding PanneLaPlusFrequente, StringFormat='• Top panne : {0}'}"
                                           FontSize="11"
                                           Foreground="#F59E0B"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Row="3"
                                       Text="Ouvrir l'historique complet ➔"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource XboxGreenBrush}" />
                        </Grid>
                    </Button>

                    <!-- CARTE 3 : RÈGLES DE SÉCURITÉ & PROTOCOLE ESD -->
                    <Border Grid.Column="2"
                            Background="#18181D"
                            BorderBrush="#3F3F46"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Height="190"
                            Margin="0,0,12,0"
                            Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <Border Background="#3B2613" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="SÉCURITÉ &amp; ESD" FontSize="9.5" FontWeight="Bold" Foreground="#FBBF24" />
                                </Border>
                                <TextBlock Text="⚠️" FontSize="16" HorizontalAlignment="Right" />
                            </DockPanel>

                            <TextBlock Grid.Row="1"
                                       Text="Règles obligatoires"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,10,0,4" />

                            <TextBlock Grid.Row="2"
                                       Text="Bracelet antistatique obligatoire. Pour toute panne d'affichage HDMI, commencez toujours par tester un boot en 480p avant tout démontage physique."
                                       FontSize="11"
                                       Foreground="#D1D5DB"
                                       TextWrapping="Wrap"
                                       LineHeight="16" />

                            <TextBlock Grid.Row="3"
                                       Text="Protocole atelier conforme ✓"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#9CA3AF" />
                        </Grid>
                    </Border>

                    <!-- CARTE 4 : ARCHITECTURES XBOX PRISES EN CHARGE -->
                    <Button Grid.Column="3"
                            Style="{StaticResource WideTileButton}"
                            Command="{Binding VoirBaseConnaissancesCommand}"
                            Height="190"
                            Margin="0,0,0,0">
                        <Grid Margin="18,16,18,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <Border Background="#1C2430" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="MATÉRIEL COMPATIBLE" FontSize="9.5" FontWeight="Bold" Foreground="#818CF8" />
                                </Border>
                                <TextBlock Text="🛠️" FontSize="16" HorizontalAlignment="Right" />
                            </DockPanel>

                            <TextBlock Grid.Row="1"
                                       Text="Xbox One Fat / S / X"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,10,0,4" />

                            <TextBlock Grid.Row="2"
                                       Text="Modèles 1540, 1681, 1787. Retimers TDP158, alimentations internes/externes, mosfets et Southbridge pris en charge."
                                       FontSize="11"
                                       Foreground="#9CA3AF"
                                       TextWrapping="Wrap"
                                       LineHeight="16" />

                            <TextBlock Grid.Row="3"
                                       Text="Consulter la base matérielle ➔"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource XboxGreenBrush}" />
                        </Grid>
                    </Button>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
