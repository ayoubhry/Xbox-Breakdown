<UserControl x:Class="XboxDiag.App.Views.IdentificationConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1100">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,24,36,36" MaxWidth="1050" HorizontalAlignment="Left">

                <!-- ========================================================= -->
                <!-- 1. EN-TÊTE ÉTAPE 1 (Style Xbox Dashboard)                 -->
                <!-- ========================================================= -->
                <StackPanel Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <Border Background="#107C10" CornerRadius="10" Padding="10,4" Margin="0,0,12,0">
                            <TextBlock Text="ÉTAPE 1 / 3" FontSize="11" FontWeight="ExtraBold" Foreground="White" />
                        </Border>
                        <TextBlock Text="Initialisation du dossier &amp; Calibrage du matériel"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Identification de la console Xbox"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White" />

                    <TextBlock Text="Renseignez le modèle exact et les détails physiques pour calibrer l'arbre d'inférence déterministe et filtrer les tests applicables."
                               FontSize="14"
                               Foreground="#CBD5E1"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>

                <!-- ========================================================= -->
                <!-- 2. CARTE 1 : MODÈLE MATÉRIEL & SPÉCIFICATIONS              -->
                <!-- ========================================================= -->
                <Border Background="#151A21"
                        BorderBrush="#2A333E"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="24"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Modèle de console Xbox *"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Foreground="White"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Background="#202A35" BorderBrush="#107C10" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="REQUIS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource XboxGreenBrush}" />
                            </Border>
                        </DockPanel>

                        <ComboBox ItemsSource="{Binding Modeles}"
                                  SelectedItem="{Binding SelectedModele, Mode=TwoWay}"
                                  DisplayMemberPath="Nom"
                                  Height="44"
                                  FontSize="14"
                                  Margin="0,0,0,16" />

                        <!-- Encadré technique riche du modèle sélectionné -->
                        <Border Background="#10151C"
                                BorderBrush="#232C37"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1C2430" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <TextBlock Text="ℹ️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Référence constructeur : " FontWeight="Medium" FontSize="12.5" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding SelectedModele.ReferenceMaterielle}" FontSize="12.5" Foreground="{StaticResource XboxGreenBrush}" FontWeight="ExtraBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedModele.Notes}"
                                               FontSize="12"
                                               Foreground="#CBD5E1"
                                               TextWrapping="Wrap"
                                               LineHeight="17" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ========================================================= -->
                <!-- 3. CARTE 2 : NUMÉRO DE SÉRIE & ÉTAT VISUEL                -->
                <!-- ========================================================= -->
                <Border Background="#151A21"
                        BorderBrush="#2A333E"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="24"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Numéro de série -->
                        <TextBlock Text="Numéro de série de la console (S/N)"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="White"
                                   Margin="0,0,0,6" />

                        <TextBox Text="{Binding NumeroSerie, UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 FontSize="13.5"
                                 Margin="0,0,0,4" />

                        <TextBlock Text="Situé sur l'étiquette code-barres à l'arrière ou sous le châssis métallique (ex : 012345678912)."
                                   FontSize="11.5"
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,18" />

                        <!-- État cosmétique et physique général -->
                        <TextBlock Text="État général &amp; Constat visuel à la réception"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="White"
                                   Margin="0,0,0,6" />

                        <TextBox Text="{Binding EtatGeneral, UpdateSourceTrigger=PropertyChanged}"
                                 Height="74"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13"
                                 Margin="0,0,0,4" />

                        <TextBlock Text="Ex. Console très encrassée, sceau de garantie inviolé, port HDMI dessoudé, traces d'impact sur le châssis."
                                   FontSize="11.5"
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,18" />

                        <!-- Historique des réparations antérieures -->
                        <TextBlock Text="Interventions ou réparations antérieures signalées"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="White"
                                   Margin="0,0,0,6" />

                        <TextBox Text="{Binding ReparationsPrecedentes, UpdateSourceTrigger=PropertyChanged}"
                                 Height="74"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13"
                                 Margin="0,0,0,4" />

                        <TextBlock Text="Ex. Pâte thermique remplacée il y a 6 mois, disque dur d'origine remplacé par un SSD Kingston, port USB changé."
                                   FontSize="11.5"
                                   Foreground="#94A3B8" />
                    </StackPanel>
                </Border>

                <!-- ========================================================= -->
                <!-- 4. ACTIONS DE NAVIGATION (Boutons Pilules Xbox)            -->
                <!-- ========================================================= -->
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left"
                            Content="← Annuler / Retour à l'accueil"
                            Command="{Binding RetourCommand}"
                            Style="{StaticResource BtnSecondary}"
                            Height="44"
                            Padding="20,0" />

                    <Button DockPanel.Dock="Right"
                            Content="Suivant : Sélection des symptômes ➔"
                            Command="{Binding SuivantCommand}"
                            Style="{StaticResource BtnPrimary}"
                            Height="44"
                            Padding="24,0" />
                </DockPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
