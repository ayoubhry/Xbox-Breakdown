<UserControl x:Class="XboxDiag.App.Views.RapportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="1150" d:DesignWidth="1100">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,24,36,36" MaxWidth="1050" HorizontalAlignment="Left">

                <!-- ========================================================= -->
                <!-- EN-TÊTE & EXPORT RAPIDE (Style Xbox Dashboard)            -->
                <!-- ========================================================= -->
                <Border Margin="0,0,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                <Border Background="#107C10" CornerRadius="10" Padding="10,4" Margin="0,0,12,0">
                                    <TextBlock Text="SYNTHÈSE EXPERTE" FontSize="11" FontWeight="ExtraBold" Foreground="White" />
                                </Border>
                                <TextBlock Text="Dossier technique de réparation &amp; Certification" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="Rapport Technique de Diagnostic"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Synthèse complète des mesures, déductions logiques de l'arbre d'inférence et rapport d'intervention."
                                       FontSize="14"
                                       Foreground="#CBD5E1"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="← Diagnostic"
                                    Command="{Binding RetourDiagnosticCommand}"
                                    Style="{StaticResource BtnSecondary}"
                                    Height="42"
                                    Margin="0,0,10,0" />

                            <Button Content="👁️ Aperçu PDF"
                                    Command="{Binding ApercuPDFCommand}"
                                    Style="{StaticResource BtnSecondary}"
                                    Height="42"
                                    Margin="0,0,10,0"
                                    Padding="16,0" />

                            <Button Content="📥 Enregistrer sous..."
                                    Command="{Binding ExporterPDFCommand}"
                                    Style="{StaticResource BtnPrimary}"
                                    Height="42"
                                    Padding="20,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ========================================================= -->
                <!-- 1. INFORMATIONS CONSOLE                                   -->
                <!-- ========================================================= -->
                <Border Background="#151A21"
                        BorderBrush="#2A333E"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="1. INFORMATIONS CONSOLE &amp; SESSION"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource XboxGreenBrush}"
                                   Margin="0,0,0,12" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Modèle matériel :" FontSize="11.5" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding NomModele}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Numéro de série :" FontSize="11.5" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding NumeroSerie}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource XboxGreenBrush}" Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Date d'ouverture :" FontSize="11.5" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding DateCreationTexte}" FontSize="13.5" Foreground="White" Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Statut de la session :" FontSize="11.5" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding StatutTexte}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource XboxGreenBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ========================================================= -->
                <!-- 2. CAUSE LA PLUS PROBABLE DÉTECTÉE                        -->
                <!-- ========================================================= -->
                <Border Background="#0E2314"
                        BorderBrush="#107C10"
                        BorderThickness="2"
                        CornerRadius="14"
                        Padding="22,18"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <Border Background="#16A34A" CornerRadius="6" Padding="10,3" HorizontalAlignment="Left">
                                <TextBlock Text="DIAGNOSTIC PRINCIPAL CONCLUANT" FontSize="11" FontWeight="ExtraBold" Foreground="White" />
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Indice de certitude : " FontSize="12.5" Foreground="#CBD5E1" />
                                <TextBlock Text="{Binding MeilleureHypothese.Confiance, StringFormat='{}{0}%'}"
                                           FontSize="16"
                                           FontWeight="ExtraBold"
                                           Foreground="#1BE31B" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Nom de la panne identifiée -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding MeilleureHypothese.Panne.Nom}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,4,0,6" />

                        <!-- Justification logique -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding MeilleureHypothese.Justification}"
                                   FontSize="13.5"
                                   Foreground="#D1D5DB"
                                   TextWrapping="Wrap"
                                   LineHeight="19" />
                    </Grid>
                </Border>

                <!-- ========================================================= -->
                <!-- 3. SYMPTÔMES SIGNALÉS                                     -->
                <!-- ========================================================= -->
                <Border Background="#151A21"
                        BorderBrush="#2A333E"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="2. SYMPTÔMES ET ANOMALIES OBSERVÉES"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource XboxGreenBrush}"
                                   Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding Symptomes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10151C"
                                            BorderBrush="#232C37"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10"
                                            Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="•" FontSize="16" Foreground="{StaticResource XboxGreenBrush}" Margin="0,0,10,0" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Description}" FontSize="13.5" Foreground="White" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ========================================================= -->
                <!-- 4. TESTS TECHNIQUES RÉALISÉS                              -->
                <!-- ========================================================= -->
                <Border Background="#151A21"
                        BorderBrush="#2A333E"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="3. TESTS TECHNIQUES EFFECTUÉS"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource XboxGreenBrush}"
                                   Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding ResultatsTests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10151C"
                                            BorderBrush="#232C37"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding TestDiagnostic.Nom}"
                                                           FontWeight="Bold"
                                                           FontSize="13.5"
                                                           Foreground="White" />
                                                <TextBlock Text="{Binding NotesTechnicien, StringFormat='Note technicien : {0}'}"
                                                           FontSize="12"
                                                           Foreground="#94A3B8"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="#1C2430" CornerRadius="6" Padding="12,5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Resultat}"
                                                           FontWeight="Bold"
                                                           FontSize="12.5"
                                                           Foreground="{StaticResource XboxGreenBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ========================================================= -->
                <!-- 5. TABLEAU COMPLET DES HYPOTHÈSES                         -->
                <!-- ========================================================= -->
                <Border Background="#151A21"
                        BorderBrush="#2A333E"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="4. ÉVALUATION DE L'ENSEMBLE DES HYPOTHÈSES DE PANNES"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource XboxGreenBrush}"
                                   Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding Hypotheses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10151C"
                                            BorderBrush="#232C37"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Panne.Nom}"
                                                       FontWeight="Bold"
                                                       FontSize="13.5"
                                                       Foreground="White"
                                                       VerticalAlignment="Center" />

                                            <ProgressBar Grid.Column="1"
                                                         Value="{Binding Confiance}"
                                                         Maximum="100"
                                                         Height="7"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,14,0" />

                                            <Border Grid.Column="2"
                                                    Background="{Binding Statut, Converter={StaticResource StatutToColorConverter}}"
                                                    CornerRadius="6"
                                                    Padding="10,4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Statut}"
                                                           FontSize="11.5"
                                                           FontWeight="Bold"
                                                           Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ========================================================= -->
                <!-- 6. CLÔTURE DU DOSSIER DE RÉPARATION                       -->
                <!-- ========================================================= -->
                <Border Background="#151A21"
                        BorderBrush="#2A333E"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="5. CLÔTURE &amp; DOSSIER DE RÉPARATION"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource XboxGreenBrush}"
                                   Margin="0,0,0,12" />

                        <!-- Formulaire si non clôturé -->
                        <StackPanel Visibility="{Binding EstNonCloture, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Composants remplacés ou réparés :"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="White"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding ComposantsRepares, UpdateSourceTrigger=PropertyChanged}"
                                     Height="38"
                                     FontSize="13"
                                     Margin="0,0,0,14" />

                            <TextBlock Text="Bilan post-réparation &amp; Tests de validation effectués :"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="White"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding ResultatReparation, UpdateSourceTrigger=PropertyChanged}"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     FontSize="13"
                                     Margin="0,0,0,14" />

                            <TextBlock Text="Remarques et préconisations pour le client :"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="White"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding NotesCloture, UpdateSourceTrigger=PropertyChanged}"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     FontSize="13"
                                     Margin="0,0,0,18" />

                            <Button Content="✓ Valider la clôture du dossier technique"
                                    Command="{Binding CloturerDossierCommand}"
                                    Style="{StaticResource BtnPrimary}"
                                    Height="44"
                                    HorizontalAlignment="Right"
                                    Padding="24,0" />
                        </StackPanel>

                        <!-- Bilan affiché si déjà clôturé -->
                        <StackPanel Visibility="{Binding EstCloture, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Background="#10151C" BorderBrush="#107C10" BorderThickness="1.5" CornerRadius="10" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding ReferenceDossier, StringFormat='Référence officielle : {0}'}"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="{StaticResource XboxGreenBrush}" />

                                    <TextBlock Text="{Binding ComposantsRepares, StringFormat='Composants remplacés : {0}'}"
                                               FontSize="13"
                                               Foreground="White"
                                               Margin="0,6,0,0" />

                                    <TextBlock Text="{Binding ResultatReparation, StringFormat='Bilan post-réparation : {0}'}"
                                               FontSize="13"
                                               Foreground="#CBD5E1"
                                               Margin="0,6,0,0" />

                                    <TextBlock Text="{Binding NotesTechnicien, StringFormat='Remarques technicien : {0}'}"
                                               FontSize="13"
                                               Foreground="#94A3B8"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ========================================================= -->
                <!-- ACTIONS FINALES DE PIED DE PAGE                           -->
                <!-- ========================================================= -->
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left"
                            Content="← Retourner au diagnostic"
                            Command="{Binding RetourDiagnosticCommand}"
                            Style="{StaticResource BtnSecondary}"
                            Height="44"
                            Padding="20,0" />

                    <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="👁️ Ouvrir le PDF"
                                Command="{Binding ApercuPDFCommand}"
                                Style="{StaticResource BtnSecondary}"
                                Height="44"
                                Margin="0,0,10,0"
                                Padding="18,0" />

                        <Button Content="📥 Enregistrer sous..."
                                Command="{Binding ExporterPDFCommand}"
                                Style="{StaticResource BtnPrimary}"
                                Height="44"
                                Margin="0,0,10,0"
                                Padding="20,0" />

                        <Button Content="⚡ Nouveau diagnostic"
                                Command="{Binding NouveauDiagnosticCommand}"
                                Style="{StaticResource BtnSecondary}"
                                Height="44"
                                Padding="18,0" />
                    </WrapPanel>
                </DockPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
