<UserControl x:Class="XboxDiag.App.Views.SelectionSymptomesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1100">

    <Grid Background="Transparent" Margin="36,24,36,28">
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="Auto" />
            <!-- Barre de recherche et filtres -->
            <RowDefinition Height="Auto" />
            <!-- Liste scrollable des symptômes -->
            <RowDefinition Height="*" />
            <!-- Barre d'actions inférieure -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 1. EN-TÊTE ÉTAPE 2                                        -->
        <!-- ========================================================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                <Border Background="#107C10" CornerRadius="10" Padding="10,4" Margin="0,0,12,0">
                    <TextBlock Text="ÉTAPE 2 / 3" FontSize="11" FontWeight="ExtraBold" Foreground="White" />
                </Border>
                <TextBlock Text="Collecte des observations cliniques" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Sélection des symptômes constatés"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White" />

            <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#CBD5E1" TextWrapping="Wrap">
                <Run Text="Console sélectionnée : " />
                <Run Text="{Binding NomModele, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource XboxGreenBrush}" />
                <Run Text=" — Cochez un ou plusieurs dysfonctionnements pour générer l'arbre des probabilités de panne." />
            </TextBlock>
        </StackPanel>

        <!-- ========================================================= -->
        <!-- 2. BARRE DE RECHERCHE ET COMPTEUR D'OBSERVATIONS          -->
        <!-- ========================================================= -->
        <Border Grid.Row="1"
                Background="#151A21"
                BorderBrush="#2A333E"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Champ de recherche filtrant -->
                <TextBox Grid.Column="0"
                         Text="{Binding TexteRecherche, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         FontSize="13.5"
                         VerticalContentAlignment="Center"
                         Margin="0,0,16,0" />

                <!-- Compteur & Reset -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#107C10" CornerRadius="8" Padding="14,8" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NbSymptomesSelectionnes}" FontWeight="Bold" Foreground="White" FontSize="13" />
                            <TextBlock Text=" symptôme(s) coché(s)" Foreground="White" FontSize="13" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Button Content="Tout décocher"
                            Command="{Binding EffacerSelectionCommand}"
                            Style="{StaticResource BtnSecondary}"
                            Height="40"
                            Padding="16,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 3. LISTE DES SYMPTÔMES GROUPÉS PAR CATÉGORIE              -->
        <!-- ========================================================= -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,18">
            <ItemsControl ItemsSource="{Binding GroupesCategories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#151A21"
                                BorderBrush="#2A333E"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="18,16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <!-- En-tête de catégorie avec badge de sélection dynamique -->
                                <Border Background="#10151C"
                                        BorderBrush="#232C37"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,12">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Titre}"
                                                   FontSize="14.5"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center" />
                                        <Border HorizontalAlignment="Right"
                                                CornerRadius="10"
                                                Padding="10,3"
                                                Background="#107C10"
                                                Visibility="{Binding HasSelectionnes, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding NbSelectionnes, StringFormat='{}{0} sélectionné(s)'}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="White" />
                                        </Border>
                                    </DockPanel>
                                </Border>

                                <!-- Liste des cases à cocher des symptômes de cette catégorie -->
                                <ItemsControl ItemsSource="{Binding Symptomes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Padding="12,10"
                                                    Margin="0,3"
                                                    CornerRadius="8"
                                                    Background="#1A212B"
                                                    BorderBrush="#25303D"
                                                    BorderThickness="1">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center">
                                                    <CheckBox.Content>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="13.5"
                                                                   Foreground="White"
                                                                   TextWrapping="Wrap"
                                                                   Margin="10,0,0,0" />
                                                    </CheckBox.Content>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ========================================================= -->
        <!-- 4. BARRE D'ACTIONS INFÉRIEURE                             -->
        <!-- ========================================================= -->
        <Border Grid.Row="3"
                Background="#0D1217"
                BorderBrush="#232C36"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="← Retour à l'identification"
                        Command="{Binding RetourCommand}"
                        Style="{StaticResource BtnSecondary}"
                        Height="44"
                        Padding="20,0" />

                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Au moins 1 symptôme requis"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#EF4444"
                               FontWeight="SemiBold"
                               Margin="0,0,16,0"
                               Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Button Content="Démarrer le diagnostic ⚡"
                            Command="{Binding DemarrerDiagnosticCommand}"
                            Style="{StaticResource BtnPrimary}"
                            Height="44"
                            Padding="24,0"
                            FontSize="14" />
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
