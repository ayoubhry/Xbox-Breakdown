<UserControl x:Class="XboxDiag.App.Views.DiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1200">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,16,24,16">
            <Grid.RowDefinitions>
                <!-- En-tête session -->
                <RowDefinition Height="Auto" />
                <!-- Contenu central splité (Hypothèses à gauche | Prochain test & Historique à droite) -->
                <RowDefinition Height="*" />
                <!-- Barre d'outils inférieure -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========================================================= -->
            <!-- 1. EN-TÊTE SESSION DE DIAGNOSTIC                          -->
            <!-- ========================================================= -->
            <Border Grid.Row="0"
                    Background="#151A21"
                    BorderBrush="#2A333E"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="20,14"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#107C10" CornerRadius="8" Padding="12,5" Margin="0,0,16,0">
                            <TextBlock Text="{Binding SessionId, StringFormat='SESSION #{0:D4}'}"
                                       FontWeight="ExtraBold"
                                       FontSize="12"
                                       Foreground="White" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NomModele}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="White" />
                                <TextBlock Text=" • S/N : "
                                           FontSize="13"
                                           Foreground="#94A3B8"
                                           Margin="10,0,0,0" />
                                <TextBlock Text="{Binding NumeroSerie}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource XboxGreenBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding DateCreationTexte, StringFormat='Session ouverte le {0}'}"
                                       FontSize="11.5"
                                       Foreground="#64748B"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Statut Session -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Statut : "
                                   FontSize="13"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center" />
                        <Border Background="#102517"
                                BorderBrush="#107C10"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Padding="12,5"
                                Margin="8,0,0,0">
                            <TextBlock Text="{Binding StatutTexte}"
                                       FontSize="12"
                                       FontWeight="ExtraBold"
                                       Foreground="{StaticResource XboxGreenBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- 2. CONTENU SPLITÉ GAUCHE / DROITE                         -->
            <!-- ========================================================= -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <!-- Colonne Gauche : Arbre des Hypothèses (Responsive) -->
                    <ColumnDefinition Width="1*" MinWidth="340" MaxWidth="500" />
                    <!-- Colonne Droite : Test recommandé & Résultats -->
                    <ColumnDefinition Width="1.3*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- ===================================================== -->
                <!-- COLONNE GAUCHE : HYPOTHÈSES DE PANNES                 -->
                <!-- ===================================================== -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardPanel}"
                        Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- En-tête des hypothèses : Titre et Filtres sans superposition -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <!-- Titre de section -->
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="🧠 Hypothèses de panne"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Hypotheses.Count, StringFormat='({0})'}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Filtres rapides d'hypothèses -->
                            <Border Background="#18181B" CornerRadius="6" Padding="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Command="{Binding FiltrerToutesCommand}"
                                            Content="{Binding NbHypothesesToutes, StringFormat='Toutes ({0})'}"
                                            FontSize="11" FontWeight="SemiBold"
                                            Height="26" Padding="2,0"
                                            BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFiltreToutes}" Value="True">
                                                    <Setter Property="Background" Value="#3F3F46" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="1"
                                        Command="{Binding FiltrerEnJeuCommand}"
                                        Content="{Binding NbHypothesesEnJeu, StringFormat='En jeu ({0})'}"
                                        FontSize="11" FontWeight="SemiBold"
                                        Height="26" Padding="2,0"
                                        BorderThickness="0" Margin="2,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFiltreEnJeu}" Value="True">
                                                    <Setter Property="Background" Value="#107C10" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding FiltrerEcarteesCommand}"
                                        Content="{Binding NbHypothesesEcartees, StringFormat='Écartées ({0})'}"
                                        FontSize="11" FontWeight="SemiBold"
                                        Height="26" Padding="2,0"
                                        BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFiltreEcartees}" Value="True">
                                                    <Setter Property="Background" Value="#DC2626" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Liste des hypothèses -->
                    <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Hypotheses}"
                                 SelectedItem="{Binding SelectedHypothese, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#18181B"
                                            BorderBrush="{Binding Statut, Converter={StaticResource StatutToColorConverter}}"
                                            BorderThickness="1.5,0,0,0"
                                            CornerRadius="6"
                                            Padding="12,10"
                                            ToolTip="{Binding Justification}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Nom de la panne et Badge de confiance -->
                                            <DockPanel Grid.Row="0">
                                                <TextBlock Text="{Binding Panne.Nom}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="260" />

                                                <TextBlock Text="{Binding Confiance, StringFormat='{}{0}%'}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           Foreground="{Binding Statut, Converter={StaticResource StatutToColorConverter}}"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>

                                            <!-- Jauge de confiance -->
                                            <ProgressBar Grid.Row="1"
                                                         Value="{Binding Confiance}"
                                                         Maximum="100"
                                                         Height="5"
                                                         Foreground="{Binding Statut, Converter={StaticResource StatutToColorConverter}}"
                                                         Margin="0,8,0,8" />

                                            <!-- Statut inféré -->
                                            <DockPanel Grid.Row="2">
                                                <TextBlock Text="{Binding Statut}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Statut, Converter={StaticResource StatutToColorConverter}}" />

                                                <TextBlock Text="ℹ️ Détails au survol"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Encadré explicatif de l'hypothèse sélectionnée -->
                        <Border Grid.Row="2"
                                Background="#18181B"
                                BorderBrush="{StaticResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,10,0,0"
                                MaxHeight="130">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Justification logique :"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedHypothese.Justification}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===================================================== -->
                <!-- COLONNE DROITE : PROCHAIN TEST & HISTORIQUE           -->
                <!-- ===================================================== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!-- Carte Prochain Test Recommandé -->
                        <RowDefinition Height="Auto" />
                        <!-- Liste des tests déjà exécutés -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- CARTE DU PROCHAIN TEST RECOMMANDÉ -->
                    <Border Grid.Row="0"
                            Style="{StaticResource CardPanel}"
                            BorderBrush="{StaticResource XboxGreenBrush}"
                            BorderThickness="1.5"
                            Margin="0,0,0,16">
                        <Grid>
                            <!-- Cas 1 : Un prochain test est recommandé -->
                            <StackPanel Visibility="{Binding HasProchainTest, Converter={StaticResource BoolToVisibilityConverter}}">
                                <WrapPanel Margin="0,0,0,8" Orientation="Horizontal">
                                    <Border Background="#107C10" CornerRadius="4" Padding="8,3" Margin="0,0,8,6">
                                        <TextBlock Text="PROCHAIN TEST RECOMMANDÉ"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </Border>

                                    <Border Background="#18181B"
                                            BorderBrush="{StaticResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,4"
                                            Margin="0,0,0,6">
                                        <TextBlock Text="{Binding ProchainTestEtoiles}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource WarningBrush}" />
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="{Binding ProchainTest.Nom}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6" />

                                <TextBlock Text="{Binding ProchainTest.Objectif}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <Border Background="#18181B" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding ProchainTest.PourquoiUtile, StringFormat='🎯 Pourquoi ce test : {0}'}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Button Content="Lancer ce test guidé ➔"
                                        Command="{Binding LancerTestCommand}"
                                        Style="{StaticResource BtnPrimary}"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        Padding="24,0" />
                            </StackPanel>

                            <!-- Cas 2 : Aucun autre test disponible / Discrimination achevée -->
                            <StackPanel Visibility="{Binding HasProchainTest, Converter={StaticResource InverseBoolToVisibilityConverter}, ConverterParameter=Inverse}"
                                        HorizontalAlignment="Center"
                                        Margin="0,16">
                                <TextBlock Text="✅" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text="Tous les tests discriminants ont été complétés"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,4" />
                                <TextBlock Text="Le moteur expert a évalué toutes les pistes. Vous pouvez générer le rapport final ou clôturer le dossier."
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12" />
                                <Button Content="Consulter le rapport technique →"
                                        Command="{Binding GenererRapportCommand}"
                                        Style="{StaticResource BtnPrimary}"
                                        Height="38"
                                        Padding="20,0"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- HISTORIQUE DES TESTS EXÉCUTÉS DANS CETTE SESSION -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="🧪 Tests déjà réalisés"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ResultatsTests.Count, StringFormat='({0} réalisé(s))'}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding ResultatsTests}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#18181B"
                                                BorderBrush="{StaticResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding TestDiagnostic.Nom}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />

                                                    <TextBlock Text="{Binding NotesTechnicien, StringFormat='Notes : {0}'}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Border Background="#27272A" CornerRadius="6" Padding="10,4">
                                                        <TextBlock Text="{Binding Resultat}"
                                                                   FontWeight="Bold"
                                                                   FontSize="12"
                                                                   Foreground="White" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Horodatage, StringFormat='{}{0:HH:mm}'}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================================= -->
            <!-- 3. BARRE D'OUTILS INFÉRIEURE                              -->
            <!-- ========================================================= -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,14,0,0">
                <DockPanel LastChildFill="False">
                    <!-- Boutons côté gauche -->
                    <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="+ Ajouter symptôme"
                                Command="{Binding OuvrirAjoutSymptomeCommand}"
                                Style="{StaticResource BtnSecondary}"
                                Height="38"
                                Margin="0,0,8,4" />

                        <Button Content="↩ Annuler dernier test"
                                Command="{Binding AnnulerDernierTestCommand}"
                                Style="{StaticResource BtnSecondary}"
                                Height="38"
                                Margin="0,0,8,4" />

                        <Button Content="🔄 Recommencer"
                                Command="{Binding RecommencerCommand}"
                                Style="{StaticResource BtnSecondary}"
                                Height="38"
                                Margin="0,0,8,4" />
                    </WrapPanel>

                    <!-- Bouton côté droit -->
                    <Button DockPanel.Dock="Right"
                            Content="📄 Générer rapport / Clôturer"
                            Command="{Binding GenererRapportCommand}"
                            Style="{StaticResource BtnPrimary}"
                            Height="38"
                            Padding="18,0"
                            Margin="0,0,0,4" />
                </DockPanel>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- ============================================================= -->
        <!-- POPUP / TIROIR D'AJOUT DE SYMPTÔME COMPLÉMENTAIRE             -->
        <!-- ============================================================= -->
        <Border Background="#AA000000"
                Visibility="{Binding IsAjouterSymptomeOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="600"
                    MaxHeight="450"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Ajouter un symptôme complémentaire"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="Sélectionnez une nouvelle observation pour actualiser instantanément les hypothèses de pannes."
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding SymptomesDisponibles}"
                             SelectedItem="{Binding SelectedSymptomeToAdd, Mode=TwoWay}"
                             Height="220"
                             Background="#18181B"
                             BorderBrush="{StaticResource BorderDarkBrush}"
                             BorderThickness="1"
                             Margin="0,0,0,16">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="13"
                                           Foreground="White"
                                           Padding="6,4"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler"
                                Command="{Binding AnnulerAjoutSymptomeCommand}"
                                Style="{StaticResource BtnSecondary}"
                                Height="36"
                                Width="100"
                                Margin="0,0,10,0" />

                        <Button Content="Valider l'ajout"
                                Command="{Binding ValiderAjoutSymptomeCommand}"
                                Style="{StaticResource BtnPrimary}"
                                Height="36"
                                Width="140" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
