<UserControl x:Class="XboxDiag.App.Views.BaseConnaissancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1100">

    <Grid Background="Transparent" Margin="36,24,36,28">
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="Auto" />
            <!-- Barre de recherche instantanée -->
            <RowDefinition Height="Auto" />
            <!-- Onglets de navigation -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 1. EN-TÊTE                                                -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <Border Background="#107C10" CornerRadius="10" Padding="10,4" Margin="0,0,12,0">
                            <TextBlock Text="DOCUMENTATION EXPERTE" FontSize="11" FontWeight="ExtraBold" Foreground="White" />
                        </Border>
                        <TextBlock Text="Règles d'inférence, arbres de pannes et catalogue clinique" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Base de Connaissances Experte"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White" />

                    <TextBlock Text="Répertoire technique des 8 pannes matérielles, 16 protocoles de tests guidés et 37 symptômes répertoriés."
                               FontSize="14"
                               Foreground="#CBD5E1"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="← Retour à l'accueil"
                        Command="{Binding RetourCommand}"
                        Style="{StaticResource BtnSecondary}"
                        Height="42"
                        Padding="20,0"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. BARRE DE RECHERCHE DANS LA BASE                        -->
        <!-- ========================================================= -->
        <Border Grid.Row="1"
                Background="#151A21"
                BorderBrush="#2A333E"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding RechercheTexte, UpdateSourceTrigger=PropertyChanged}"
                         Height="38"
                         FontSize="13.5"
                         VerticalContentAlignment="Center"
                         Margin="0,0,14,0" />

                <Button Grid.Column="1"
                        Content="Effacer le filtre"
                        Command="{Binding EffacerRechercheCommand}"
                        Style="{StaticResource BtnSecondary}"
                        Height="38"
                        Padding="16,0" />
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 3. ONGLETS TECHNIQUES XBOX                                -->
        <!-- ========================================================= -->
        <TabControl Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- ONGLET 1 : PANNES -->
            <TabItem Header="{Binding TitreOngletPannes}">
                <Border Background="#151A21"
                        BorderBrush="#2A333E"
                        BorderThickness="1.5"
                        CornerRadius="0,12,12,12"
                        Padding="20"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" MinWidth="240" MaxWidth="380" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding Pannes}"
                                 SelectedItem="{Binding SelectedPanne, Mode=TwoWay}"
                                 Background="#10151C"
                                 BorderBrush="#232C37"
                                 BorderThickness="1"
                                 FontSize="13.5"
                                 Padding="8"
                                 Margin="0,0,18,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nom}" FontSize="13.5" Foreground="White" Padding="8,6" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="{Binding SelectedPanne.Nom}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="Description technique :"
                                           FontWeight="Bold"
                                           FontSize="13.5"
                                           Foreground="#CBD5E1" />
                                <TextBlock Text="{Binding SelectedPanne.Description}"
                                           FontSize="13.5"
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           LineHeight="20"
                                           Margin="0,4,0,18" />

                                <TextBlock Text="Symptômes révélateurs &amp; Poids de causalité :"
                                           FontWeight="Bold"
                                           FontSize="13.5"
                                           Foreground="{StaticResource XboxGreenBrush}"
                                           Margin="0,0,0,10" />

                                <ItemsControl ItemsSource="{Binding SelectedPanne.PanneSymptomes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#10151C"
                                                    BorderBrush="#232C37"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="•" Foreground="{StaticResource XboxGreenBrush}" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Symptome.Description}" FontSize="13" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <Border Grid.Column="2" Background="#2B2111" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Poids, StringFormat='Poids: {0}/10'}" FontSize="11" Foreground="#FBBF24" FontWeight="Bold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ONGLET 2 : TESTS GUIDÉS -->
            <TabItem Header="{Binding TitreOngletTests}">
                <Border Background="#151A21"
                        BorderBrush="#2A333E"
                        BorderThickness="1.5"
                        CornerRadius="0,12,12,12"
                        Padding="20"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" MinWidth="240" MaxWidth="380" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding Tests}"
                                 SelectedItem="{Binding SelectedTest, Mode=TwoWay}"
                                 Background="#10151C"
                                 BorderBrush="#232C37"
                                 BorderThickness="1"
                                 FontSize="13.5"
                                 Padding="8"
                                 Margin="0,0,18,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nom}" FontSize="13.5" Foreground="White" Padding="8,6" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="{Binding SelectedTest.Nom}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />

                                <Border Background="#2B2111" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding SelectedTest.Difficulte, StringFormat='Difficulté technique : {0}'}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#FBBF24" />
                                </Border>

                                <TextBlock Text="Objectif de la procédure :" FontWeight="Bold" FontSize="13.5" Foreground="#CBD5E1" />
                                <TextBlock Text="{Binding SelectedTest.Objectif}" FontSize="13.5" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,14" />

                                <TextBlock Text="Pourquoi ce test est discriminant :" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource XboxGreenBrush}" />
                                <TextBlock Text="{Binding SelectedTest.PourquoiUtile}" FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,14" />

                                <TextBlock Text="Matériel requis :" FontWeight="Bold" FontSize="13.5" Foreground="#CBD5E1" />
                                <TextBlock Text="{Binding SelectedTest.MaterielNecessaire}" FontSize="13.5" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,14" />

                                <TextBlock Text="Procédure opératoire pas à pas :" FontWeight="Bold" FontSize="13.5" Foreground="#CBD5E1" />
                                <Border Background="#10151C" BorderBrush="#232C37" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,6,0,14">
                                    <TextBlock Text="{Binding SelectedTest.Etapes}" FontSize="13.5" LineHeight="21" Foreground="White" TextWrapping="Wrap" />
                                </Border>

                                <TextBlock Text="Consignes de sécurité &amp; ESD :" FontWeight="Bold" FontSize="13.5" Foreground="#F87171" />
                                <Border Background="#2B1515" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,6,0,10">
                                    <TextBlock Text="{Binding SelectedTest.PrecautionsSecurite}" FontSize="13" Foreground="#FECACA" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ONGLET 3 : CATALOGUE DES SYMPTÔMES -->
            <TabItem Header="{Binding TitreOngletSymptomes}">
                <Border Background="#151A21"
                        BorderBrush="#2A333E"
                        BorderThickness="1.5"
                        CornerRadius="0,12,12,12"
                        Padding="0"
                        Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding Symptomes}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N°" Binding="{Binding Id}" Width="65" MinWidth="50" FontWeight="Bold" />
                            <DataGridTextColumn Header="Catégorie" Binding="{Binding Categorie}" Width="180" MinWidth="130" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Description du dysfonctionnement" Binding="{Binding Description}" Width="*" MinWidth="260" />
                            <DataGridTextColumn Header="Spécifique modèle" Binding="{Binding ModeleConsole.Nom}" Width="180" MinWidth="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
