<UserControl x:Class="XboxDiag.App.Views.AssistantTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="950" d:DesignWidth="1100">

    <Grid Background="Transparent" Margin="36,24,36,28">
        <Grid.RowDefinitions>
            <!-- En-tête du test -->
            <RowDefinition Height="Auto" />
            <!-- Corps scrollable du protocole de test -->
            <RowDefinition Height="*" />
            <!-- Zone des 4 boutons de résultat -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 1. EN-TÊTE DU TEST & NIVEAU DE DIFFICULTÉ                 -->
        <!-- ========================================================= -->
        <Border Grid.Row="0"
                Background="#151A21"
                BorderBrush="#2A333E"
                BorderThickness="1.5"
                CornerRadius="14"
                Padding="22,16"
                Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <!-- Bouton Revenir en arrière -->
                    <Button Content="← Revenir au diagnostic"
                            Command="{Binding RetourCommand}"
                            Style="{StaticResource BtnSecondary}"
                            Height="34"
                            Padding="16,0" />

                    <!-- Badge de difficulté -->
                    <Border Background="#2B2111"
                            BorderBrush="#F59E0B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,4"
                            HorizontalAlignment="Right">
                        <TextBlock Text="{Binding DifficulteTexte}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#FBBF24" />
                    </Border>
                </DockPanel>

                <!-- Titre du test -->
                <TextBlock Grid.Row="1"
                           Text="{Binding Nom}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. PROTOCOLE TECHNIQUE ET CONSIGNES                       -->
        <!-- ========================================================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18">
            <StackPanel>
                <!-- OBJECTIF & UTILITÉ -->
                <Border Background="#151A21"
                        BorderBrush="#2A333E"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Objectif -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="🎯 Objectif mesurable du test :"
                                       FontWeight="Bold"
                                       FontSize="13.5"
                                       Foreground="#CBD5E1" />
                            <TextBlock Text="{Binding Objectif}"
                                       FontSize="14"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Pourquoi ce test est utile -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="💡 Pourquoi cette vérification est discriminante :"
                                       FontWeight="Bold"
                                       FontSize="13.5"
                                       Foreground="{StaticResource XboxGreenBrush}" />
                            <TextBlock Text="{Binding PourquoiUtile}"
                                       FontSize="13"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MATÉRIEL INDISPENSABLE -->
                <Border Background="#151A21"
                        BorderBrush="#2A333E"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🧰 Matériel et outillage nécessaires :"
                                   FontWeight="Bold"
                                   FontSize="13.5"
                                   Foreground="#CBD5E1" />
                        <TextBlock Text="{Binding MaterielNecessaire}"
                                   FontSize="13.5"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- ÉTAPES PAS À PAS NUMÉROTÉES -->
                <Border Background="#151A21"
                        BorderBrush="#2A333E"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="📋 Procédure opératoire détaillée (Étapes pas à pas) :"
                                   FontWeight="Bold"
                                   FontSize="14.5"
                                   Foreground="White"
                                   Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding ListeEtapes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10151C"
                                            BorderBrush="#232C37"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16,14"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Badge Cercle Numéro d'étape Xbox Green -->
                                            <Border Grid.Column="0"
                                                    Width="34" Height="34"
                                                    CornerRadius="17"
                                                    Background="#107C10"
                                                    Margin="0,0,16,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Numero}"
                                                           FontWeight="ExtraBold"
                                                           FontSize="14"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Consigne textuelle de l'étape -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Description}"
                                                       FontSize="14"
                                                       LineHeight="21"
                                                       Foreground="White"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- CONSIGNES DE SÉCURITÉ & RISQUES (Orange / Rouge) -->
                <Border Background="#2B1515"
                        BorderBrush="#DC2626"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="18,16"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasPrecautions, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="⚠️" FontSize="28" Margin="0,0,16,0" VerticalAlignment="Top" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Consignes de sécurité indispensables &amp; Risques potentiels"
                                       FontWeight="Bold"
                                       FontSize="14.5"
                                       Foreground="#F87171" />

                            <TextBlock Text="{Binding PrecautionsSecurite}"
                                       FontSize="13"
                                       Foreground="#FECACA"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,4" />

                            <TextBlock Text="{Binding Risques, StringFormat='Risques encourus : {0}'}"
                                       FontSize="12.5"
                                       Foreground="#FCA5A5"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasRisques, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SAISIE DES REMARQUES OU VALEURS DU TECHNICIEN -->
                <Border Background="#151A21"
                        BorderBrush="#2A333E"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="📝 Notes et mesures relevées par le technicien (Optionnel) :"
                                   FontWeight="Bold"
                                   FontSize="13.5"
                                   Foreground="#CBD5E1"
                                   Margin="0,0,0,6" />

                        <TextBox Text="{Binding NotesTechnicien, UpdateSourceTrigger=PropertyChanged}"
                                 Height="65"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13.5" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================= -->
        <!-- 3. LES 4 BOUTONS DE RÉSULTAT DU TEST                      -->
        <!-- ========================================================= -->
        <Border Grid.Row="2"
                Background="#0D1217"
                BorderBrush="#232C36"
                BorderThickness="0,1,0,0"
                Padding="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Indiquez le résultat constaté lors de l'exécution du test pour mettre à jour les probabilités de pannes :"
                           FontSize="12.5"
                           Foreground="#94A3B8"
                           Margin="0,0,0,10" />

                <!-- 4 Gros Boutons de résultat Xbox -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 1. CONFORME (Vert) -->
                    <Button Grid.Column="0"
                            Command="{Binding ConformeCommand}"
                            Style="{StaticResource BtnPrimary}"
                            Height="50"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="20" FontWeight="Bold" Margin="0,0,8,0" />
                            <TextBlock Text="Conforme (Normal)" FontWeight="Bold" FontSize="14" />
                        </StackPanel>
                    </Button>

                    <!-- 2. NON CONFORME (Rouge) -->
                    <Button Grid.Column="1"
                            Command="{Binding NonConformeCommand}"
                            Style="{StaticResource BtnDanger}"
                            Height="50"
                            Margin="4,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" FontSize="20" FontWeight="Bold" Margin="0,0,8,0" />
                            <TextBlock Text="Non conforme (Défaut)" FontWeight="Bold" FontSize="14" />
                        </StackPanel>
                    </Button>

                    <!-- 3. INCERTAIN (Orange) -->
                    <Button Grid.Column="2"
                            Command="{Binding IncertainCommand}"
                            Height="50"
                            Margin="4,0,4,0"
                            Cursor="Hand"
                            BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#D97706" CornerRadius="8" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="?" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,8,0" />
                                        <TextBlock Text="Incertain / Mitigé" FontWeight="Bold" FontSize="14" Foreground="White" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#F59E0B" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 4. IMPOSSIBLE (Gris) -->
                    <Button Grid.Column="3"
                            Command="{Binding ImpossibleCommand}"
                            Style="{StaticResource BtnSecondary}"
                            Height="50"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊘" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="Impossible à réaliser" FontWeight="Medium" FontSize="13.5" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
