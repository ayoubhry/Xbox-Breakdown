<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Xbox Breakdown</AssemblyName>
    <RootNamespace>XboxDiag.App</RootNamespace>
    <ApplicationTitle>Xbox Breakdown — Diagnostic Xbox One</ApplicationTitle>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <!-- Optimisations de taille, d'empaquetage et de praticite -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XboxDiag.Core\XboxDiag.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\app.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Empêcher QuestPDF ou autres cibles de copier le dossier LatoFont dans la publication -->
    <None Update="LatoFont\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="LatoFont\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
